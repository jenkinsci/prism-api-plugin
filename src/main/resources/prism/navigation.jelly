<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <st:documentation>
    Renders floating buttons in the lower right corner of the page to navigate to the previous and next marker of the
    source code view, together with the position of the selected marker (e.g., "3 / 12"). The buttons are shown only
    if there are at least two visible markers. The navigation is handled by the script of the source code view
    (SourceCodeViewModel/source-code.js), which also provides the keyboard shortcuts 'j' (next marker) and 'k'
    (previous marker). Hidden markers (e.g., removed by a filter of the page) are skipped. This tag is part of the
    fragment SourceCodeViewModel/content.jelly, so pages that embed the source code do not need to add it.
  </st:documentation>

  <div class="prism-navigation jenkins-mobile-hide" aria-hidden="true">
    <button type="button" class="jenkins-button prism-navigation__button"
            data-prism-navigation="previous" tooltip="${%previous}" aria-label="${%previous}">
      <l:icon src="symbol-arrow-up-outline plugin-ionicons-api"/>
    </button>
    <span class="prism-navigation__position" data-prism-navigation="position" tooltip="${%position}">-</span>
    <button type="button" class="jenkins-button prism-navigation__button"
            data-prism-navigation="next" tooltip="${%next}" aria-label="${%next}">
      <l:icon src="symbol-arrow-down-outline plugin-ionicons-api"/>
    </button>
  </div>
</j:jelly>
