{
  "name": "prism-api",
  "version": "1.30.0",
  "description": "Prism JS Jenkins Plugin",
  "directories": {
    "doc": "doc"
  },
  "dependencies": {
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "remark-cli": "^12.0.1",
    "remark-lint": "10.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "lint-md": "remark .",
    "mvnbuild": "",
    "mvntest": "vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-lint-recommended"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenkinsci/prism-api-plugin.git"
  },
  "author": "Ullrich Hafner",
  "license": "MIT",
  "homepage": "https://github.com/jenkinsci/prism-api-plugin#readme",
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "chokidar": "^4.0.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
